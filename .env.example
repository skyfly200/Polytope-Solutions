# Copy to .env for local use. Never commit .env; .gitignore already excludes it.
# In Netlify, set these under Site configuration > Environment variables.

# Mailgun (existing contact and application forms)
MAILGUN_API_KEY=
DOMAIN=
CONTACT_EMAIL=

# Neon serverless Postgres (clients and projects). Use the pooled connection string
# from the Neon console, with sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Shared secret for the admin API (/.netlify/functions/clients and /projects).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# Copy to .env for local use. Never commit .env; .gitignore already excludes it.
# In Netlify, set these under Site configuration > Environment variables.

# Mailgun (/start notifications and auto-replies, plus the older contact and application forms).
# The API key lives only here and in Netlify env vars, never in code. If unset, emails are skipped with a log line.
MAILGUN_API_KEY=
# Verified sending domain, e.g. mail.polytopesolutions.com
DOMAIN=
# Where new-lead notifications go
CONTACT_EMAIL=
# Optional: default From address and EU API base
# MAILGUN_FROM=Polytope Solutions <contact@mail.polytopesolutions.com>
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Neon serverless Postgres (clients and projects). Use the pooled connection string
# from the Neon console, with sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Shared secret for the admin API (/.netlify/functions/clients and /projects).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
